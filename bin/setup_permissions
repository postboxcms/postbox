#!/usr/bin/env bash
set -e

APP_DIR=$(pwd)
APP_USER=$SUDO_USER
WEB_USER="www-data"
WEB_GROUP="web"

echo "🔍 Checking web permissions..."

# --- Helpers -------------------------------------------------

group_exists() {
  getent group "$1" >/dev/null 2>&1
}

user_in_group() {
  id -nG "$1" | tr ' ' '\n' | grep -qx "$2"
}

ensure_group() {
  if group_exists "$WEB_GROUP"; then
    echo "✔ Group '$WEB_GROUP' exists"
  else
    echo "➕ Creating group '$WEB_GROUP'"
    groupadd "$WEB_GROUP"
  fi
}

ensure_user_in_group() {
  local user="$1"
  if user_in_group "$user" "$WEB_GROUP"; then
    echo "✔ User '$user' already in group '$WEB_GROUP'"
  else
    echo "➕ Adding '$user' to group '$WEB_GROUP'"
    usermod -aG "$WEB_GROUP" "$user"
  fi
}

ensure_owner() {
  local owner group
  owner=$(stat -c '%U' "$APP_DIR")
  group=$(stat -c '%G' "$APP_DIR")

  if [[ "$owner" == "$APP_USER" && "$group" == "$WEB_GROUP" ]]; then
    echo "✔ Ownership already correct"
  else
    echo "🔧 Fixing ownership"
    chown -R "$APP_USER:$WEB_GROUP" "$APP_DIR"
  fi
}

ensure_permissions() {
  echo "🔧 Ensuring directory and file permissions"

  find "$APP_DIR" -type d ! -perm 2775 -exec chmod 2775 {} \;
  find "$APP_DIR" -type f ! -perm 664  -exec chmod 664  {} \;
}

ensure_laravel_writable() {
  for dir in storage bootstrap/cache; do
    if [ -d "$APP_DIR/$dir" ]; then
      echo "🔧 Ensuring write access for $dir"
      chmod -R g+w "$APP_DIR/$dir"
    fi
  done
}

ensure_selinux() {
  if command -v getenforce >/dev/null && [ "$(getenforce)" != "Disabled" ]; then
    echo "🔐 Ensuring SELinux contexts"

    current=$(ls -Zd "$APP_DIR" | awk '{print $1}')
    if [[ "$current" != *httpd_sys_content_t* ]]; then
      chcon -R -t httpd_sys_content_t "$APP_DIR"
    fi

    chcon -R -t httpd_sys_rw_content_t \
      "$APP_DIR/storage" \
      "$APP_DIR/bootstrap/cache"
  fi
}

# --- Execution ------------------------------------------------

ensure_group
ensure_user_in_group "$APP_USER"
ensure_user_in_group "$WEB_USER"
ensure_owner
ensure_permissions
ensure_laravel_writable
ensure_selinux

echo "✅ Permission state verified and enforced"
echo "⚠️  Log out and back in if group membership was changed"
