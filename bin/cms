#!/usr/bin/env bash


show_help() {
    echo "Usage: bin/cms [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --help, -h          Show this help message and exit"
    echo "  --with, -w [envs]   Setup environment(s). Possible values: docker, host"
    echo ""
    echo "Examples:"
    echo "  cms --with docker"
    echo "  cms --with host"
}

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi

if [ "$1" = "--with" ] || [ "$1" = "-w" ]; then
    for arg in "$@"; do
        if [ "$arg" = "docker" ]; then
            source bin/env/docker
            setup_environment || exit 1
            setup_composer || exit 1
            setup_node || exit 1
            setup_docker || exit 1
        fi

        if [ "$arg" = "host" ]; then
            source bin/env/host/system
            source bin/env/host/permissions
            source bin/env/host/dependencies
            setup_system || exit 1           
            setup_permissions || exit 1
            setup_dependencies || exit 1
            setup_php_composer || exit 1
            setup_assets || exit 1
            setup_environment_variables || exit 1
        fi
    done
fi

if [ "$1" = "--setup" ]; then
    read -p "🌐 Enter site name: " site_name
    read -p "🔗 Enter site URL: " site_url
    read -p "🔌 Enter port number: " port_number

    # Update .env file with user inputs
    sed -i "s/^APP_NAME=.*/APP_NAME=${site_name}/" .env
    sed -i "s|^APP_URL=.*|APP_URL=${site_url}|" .env
    sed -i "s/^PORT=.*/PORT=${port_number}/" .env

    echo "✔ Environment variables updated successfully."
fi

if [ "$#" -eq 0 ]; then
    show_help
    exit 1
fi