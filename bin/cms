#!/usr/bin/env bash


show_help() {
    echo "Usage: bin/cms [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --help, -h          Show this help message and exit"
    echo "  --with, -w [envs]   Setup environment(s). Possible values: docker, host"
    echo ""
    echo "Examples:"
    echo "  cms --with docker"
    echo "  cms --with host"
}

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi

if [ "$1" = "--with" ] || [ "$1" = "-w" ]; then
    for arg in "$@"; do
        if [ "$arg" = "docker" ]; then
            source bin/env/docker
            setup_environment || exit 1
            setup_composer || exit 1
            setup_node || exit 1
            setup_docker || exit 1
        fi

        if [ "$arg" = "host" ]; then
            source bin/env/host/system
            source bin/env/host/permissions
            source bin/env/host/dependencies
            setup_system || exit 1           
            setup_permissions || exit 1
            setup_dependencies || exit 1
            setup_php_composer || exit 1
            setup_assets || exit 1
            setup_environment_variables || exit 1
            setup_bin_folder_permissions || exit 1
        fi
    done
fi

if [ "$1" = "--setup" ]; then
    read -p "🌐 Enter site name: " site_name
    read -p "🔗 Enter site URL: " site_url
    read -p "🔌 Enter port number: " port_number
    read -p "🗄️  Enter database host: " db_host
    read -p "💾 Enter database name: " db_name
    read -p "👤 Enter database user: " db_user
    read -sp "🔒 Enter database password: " db_password
    echo ""
    echo "🗄️ Configuring database..."
    mysql -h "$db_host" -u root -p -e "CREATE USER IF NOT EXISTS '$db_user'@'$db_host' IDENTIFIED BY '$db_password'; GRANT ALL PRIVILEGES ON \`$db_name\`.* TO '$db_user'@'$db_host'; FLUSH PRIVILEGES;"
    read -p "🗄️ Would you like to create the database now? (y/n): " create_db_choice
    echo ""
    if [[ "$create_db_choice" =~ ^[Yy]$ ]]; then
        mysql -h "$db_host" -u "$db_user" -p"$db_password" -e "CREATE DATABASE IF NOT EXISTS \`$db_name\`;"
        if [ $? -eq 0 ]; then
            echo -e "✔ Database '$db_name' created successfully."
        else
            echo -e "✘ Failed to create database '$db_name'. Please check your credentials and try again."
            exit 1
        fi
    fi

    # Update .env file with user inputs
    sed -i "s/^APP_NAME=.*/APP_NAME=${site_name}/" .env
    sed -i "s|^APP_URL=.*|APP_URL=${site_url}|" .env
    sed -i "s/^PORT=.*/PORT=${port_number}/" .env
    sed -i "s/^DB_HOST=.*/DB_HOST=${db_host}/" .env
    sed -i "s/^DB_DATABASE=.*/DB_DATABASE=${db_name}/" .env
    sed -i "s/^DB_USERNAME=.*/DB_USERNAME=${db_user}/" .env
    sed -i "s/^DB_PASSWORD=.*/DB_PASSWORD=${db_password}/" .env

    echo ""
    echo -e "✔ Environment variables updated successfully."
    echo ""
    cp bin/env/host/site_config /etc/nginx/sites-available/"${site_name}"
    sed -i "s/domain_name/${site_url}/g" /etc/nginx/sites-available/"${site_name}"
    sed -i "s/port_number/${port_number}/g" /etc/nginx/sites-available/"${site_name}"
    sed -i "s|document_root|$(pwd)|g" /etc/nginx/sites-available/"${site_name}"
    ln -sf /etc/nginx/sites-available/"${site_name}" /etc/nginx/sites-enabled/"${site_name}"
    echo "✔ Nginx configuration created and symlink established."
fi


if [ "$#" -eq 0 ]; then
    show_help
    exit 1
fi