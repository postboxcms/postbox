#!/usr/bin/env bash

# Usage: ./yaml_to_env.sh /path/to/input.yaml /path/to/output.env

set -e

INPUT_YAML="$1"
OUTPUT_ENV="$2"

if [[ -z "$INPUT_YAML" || -z "$OUTPUT_ENV" ]]; then
  echo "Usage: $0 input.yaml output.env"
  exit 1
fi

if [[ ! -f "$INPUT_YAML" ]]; then
  echo "Input file does not exist: $INPUT_YAML"
  exit 1
fi

> "$OUTPUT_ENV"

while IFS= read -r line || [[ -n "$line" ]]; do
  # Trim whitespace
  line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

  # Skip empty lines and comments
  [[ -z "$line" || "$line" =~ ^# ]] && continue

  # Match key: value
  if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*:[[:space:]]*(.*)$ ]]; then
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"

    # Remove surrounding quotes if present
    value="$(echo "$value" | sed -E 's/^["'\''](.*)["'\'']$/\1/')"

    # Escape double quotes
    value="${value//\"/\\\"}"

    echo "${key}=\"${value}\"" >> "$OUTPUT_ENV"

    # Handle variables with blank values and dont add quotes for example abc: should be replaced with abc=""
  elif [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*:[[:space:]]*$ ]]; then
    key="${BASH_REMATCH[1]}"
    echo "${key}=\"\"" >> "$OUTPUT_ENV"
  else
    echo "Warning: Could not parse line: $line"
  fi
done < "$INPUT_YAML"

echo "Converted $INPUT_YAML → $OUTPUT_ENV"
