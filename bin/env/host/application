#!/usr/bin/env bash

setup_application() {
    # Check if CMS installation is already complete
    PHP_VERSION=$(php -r 'echo phpversion();' | cut -d'.' -f1,2)

    if grep -q "^CMS_INSTALLATION=success" .env; then
        site_name=$(grep "^APP_NAME=" .env | cut -d'=' -f2)
        site_url=$(grep "^APP_URL=" .env | cut -d'=' -f2)
        port_number=$(grep "^APP_PORT=" .env | cut -d'=' -f2)
        echo "✔ CMS is already installed. Skipping setup ..."
        echo ""
    else
        echo "🔍 Setting up host application ..."
        read -p "🌐 Enter site name: " site_name
        read -p "🔗 Enter site URL: " site_url
        read -p "🔌 Enter port number: " port_number
        read -p "🗄️ Enter database host: " db_host
        read -p "💾 Enter database name: " db_name
        read -p "👤 Enter database user: " db_user
        read -sp "🔒 Enter database password: " db_password
        echo ""
        echo "🗄️ Configuring database..."
        mysql -h "$db_host" -u root -p -e "CREATE USER IF NOT EXISTS '$db_user'@'$db_host' IDENTIFIED BY '$db_password'; GRANT ALL PRIVILEGES ON \`$db_name\`.* TO '$db_user'@'$db_host'; FLUSH PRIVILEGES;"
        if [ $? -eq 0 ]; then
            echo -e "✔ Database user '$db_user' configured successfully."
        else
            echo -e "✘ Failed to configure database user: '$db_user'. Please check your credentials and try again."
            exit 1
        fi
        read -p "🗄️ Would you like to create the database now? (y/n): " create_db_choice
        echo ""
        if [[ "$create_db_choice" =~ ^[Yy]$ ]]; then
            mysql -h "$db_host" -u "$db_user" -p"$db_password" -e "CREATE DATABASE IF NOT EXISTS \`$db_name\`;"
            if [ $? -eq 0 ]; then
                echo -e "✔ Database '$db_name' created successfully."
            else
                echo -e "✘ Failed to create database '$db_name'. Please check your credentials and try again."
                exit 1
            fi
        fi

        # Update .env file with user inputs
        sed -i "s/^APP_NAME=.*/APP_NAME=${site_name}/" .env
        sed -i "s|^APP_URL=.*|APP_URL=${site_url}|" .env
        sed -i "s/^PORT=.*/PORT=${port_number}/" .env
        sed -i "s/^DB_HOST=.*/DB_HOST=${db_host}/" .env
        sed -i "s/^DB_DATABASE=.*/DB_DATABASE=${db_name}/" .env
        sed -i "s/^DB_USERNAME=.*/DB_USERNAME=${db_user}/" .env
        sed -i "s/^DB_PASSWORD=.*/DB_PASSWORD=${db_password}/" .env
        echo ""
        echo -e "✔ Environment variables updated successfully."
        # update cms installation flag
        echo "🔧 Finalizing CMS installation..."
        sed -i 's/^CMS_INSTALLATION=.*/CMS_INSTALLATION=success/' .env > /dev/null 2>&1
        echo -e "✔ CMS installation DONE."
    fi
    echo ""
    echo "⚙️ Setting up Nginx configuration..."
    echo "🔧 Creating Nginx configuration for application ${site_name}..."
    sudo cp bin/env/host/nginx/app /etc/nginx/sites-available/"${site_name}"
    sed -i "s/{{DOMAIN_NAME}}/$(echo ${site_url} | sed 's|https\?://||')/g" /etc/nginx/sites-available/"${site_name}"
    sed -i "s/{{PORT}}/${port_number}/g" /etc/nginx/sites-available/"${site_name}"
    sed -i "s|{{DOCUMENT_ROOT}}|$(pwd)|g" /etc/nginx/sites-available/"${site_name}"
    sed -i "s/{{PHP_VERSION}}/${PHP_VERSION}/g" /etc/nginx/sites-available/"${site_name}"
    ln -sf /etc/nginx/sites-available/"${site_name}" /etc/nginx/sites-enabled/"${site_name}"
    echo "✔ Nginx configuration for application ${site_name} created and symlink established."
    echo ""
    echo "⚙️ Setting up Nginx SSR configuration..."
    echo "🔧 Creating Nginx SSR configuration for application ${site_name}..."
    sudo cp bin/env/host/nginx/ssr /etc/nginx/sites-available/"${site_name}"-ssr
    sed -i "s/{{DOMAIN_NAME}}/$(echo ${site_url} | sed 's|https\?://||')-ssr/g" /etc/nginx/sites-available/"${site_name}"-ssr
    sed -i "s/{{PORT}}/${port_number}/g" /etc/nginx/sites-available/"${site_name}"-ssr
    sed -i "s|{{DOCUMENT_ROOT}}|$(pwd)|g" /etc/nginx/sites-available/"${site_name}"-ssr
    sed -i "s/{{PHP_VERSION}}/${PHP_VERSION}/g" /etc/nginx/sites-available/"${site_name}"-ssr
    ln -sf /etc/nginx/sites-available/"${site_name}"-ssr /etc/nginx/sites-enabled/"${site_name}"-ssr
    echo "✔ Nginx SSR configuration for application ${site_name} created and symlink established."
    echo ""
    echo "⚙️ Copying SSR systemd service file..."
    sudo cp bin/env/host/conf/ssr.conf /etc/systemd/system/ssr.service
    sed -i "s|{{DOCUMENT_ROOT}}|$(pwd)|g" /etc/systemd/system/ssr.service
    echo "✔ SSR systemd service file copied."
    echo ""    
    echo "🔄 Reloading systemd daemon and enabling SSR service..."
    sudo systemctl daemon-reexec
    sudo systemctl daemon-reload
    sudo systemctl enable ssr
    sudo systemctl start ssr
    echo -e "✔ SSR systemd service setup complete."
    echo ""
    echo "🔄 Restarting Nginx to apply changes..."
    sudo systemctl restart nginx
    echo -e "✔ Nginx restarted successfully."   
    # Application setup steps go here
    echo "✔ Host application setup complete"
}