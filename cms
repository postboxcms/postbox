#!/usr/bin/env bash

RESET='\033[0m'
WHITE='\033[0;37m'
RED='\e[31m'
YELLOW='\e[33m'
GREEN='\033[0;32m'
CHECK='\u2714'
LOADING='\u23F3'
SNAKE='\uD83D\uDC0D'
ERROR='\u274C'
STATUS='Idle'

MACHINE="$(uname -s)"
PHP_VERSION=$(php -r "echo PHP_VERSION;")
NODE_VERSION=$(node -v 2>/dev/null | sed 's/v//')

case "${MACHINE}" in
    Linux*)             SYSTEM=linux;;
    Darwin*)            SYSTEM=mac;;
    *)                  SYSTEM="UNKNOWN"
esac

if [ "$SYSTEM" = "UNKNOWN" ]; then
    echo -e "${RED} Unsupported operating system [$(uname -s)]. PostboxCMS Desk supports macOS, Linux, and Windows (WSL2).${RESET}" >&2
    exit 1
fi


if [[ "$PHP_VERSION" < "8" ]]; then
    echo -e "${RED} PostboxCMS Desk requires PHP version 8 or higher. Current version: $PHP_VERSION ${RESET}" >&2
    exit 1
fi

if ! command -v docker &> /dev/null; then
    echo -e "${RED}${ERROR} Docker is not installed. Please install Docker to proceed.${RESET}" >&2
    exit 1
fi

setup_environment() {
    sudo apt-get update > /dev/null 
    STATUS='Starting'
    echo -e "${GREEN}${LOADING} ${WHITE}Analyzing system requirements \t\t ${GREEN}${STATUS} ${RESET}"
    if ! command -v php &> /dev/null; then
        STATUS='Failed'
        echo -ne "\033[1A\r${GREEN}${ERROR} ${WHITE}Analyzing system requirements \t\t  ${RED}${STATUS} ${RESET}\n"
        echo -e "${RED} PHP is not installed. Please install PHP version 8.2 or higher.${RESET}" >&2
        exit 1
    fi

    if ! command -v composer &> /dev/null; then
        STATUS='Failed'
        echo -ne "\033[1A\r${GREEN}${ERROR} ${WHITE}Analyzing system requirements \t\t  ${RED}${STATUS} ${RESET}\n"
        echo -e "${RED} Composer is not installed. Please install Composer to proceed.${RESET}" >&2
        exit 1
    fi

    if ! command -v node &> /dev/null; then
        STATUS='Failed'
        echo -ne "\033[1A\r${GREEN}${ERROR} ${WHITE}Analyzing system requirements \t\t  ${RED}${STATUS} ${RESET}\n"
        echo -e "${RED} Node.js is not installed. Please install Node.js version 20 or higher.${RESET}" >&2
        exit 1
    fi

    if ! command -v npm &> /dev/null; then
        STATUS='Failed'
        echo -ne "\033[1A\r${GREEN}${ERROR} ${WHITE}Analyzing system requirements \t\t  ${RED}${STATUS} ${RESET}\n"
        echo -e "${RED} npm is not installed. Please install npm to proceed.${RESET}" >&2
        exit 1
    fi

    if [[ "$NODE_VERSION" < "20" ]]; then
        STATUS='Failed'
        echo -ne "\033[1A\r${GREEN}${ERROR} ${WHITE}Analyzing system requirements \t\t  ${RED}${STATUS} ${RESET}\n"
        echo -e "${RED} PostboxCMS Desk requires Node.js version 20 or higher. Current version: $NODE_VERSION ${RESET}" >&2
        exit 1
    fi

    STATUS='Finished'
    echo -ne "\033[1A\r${GREEN}${CHECK} ${WHITE}Analyzing system requirements \t\t ${GREEN}${STATUS} ${RESET}"

    STATUS='Starting'
    echo -e "\n${GREEN}${LOADING} ${WHITE}Installing missing php extensions \t\t ${GREEN}${STATUS} ${RESET}"
    REQUIRED_EXTENSIONS=(xml curl gd imagick fileinfo openssl)
    for EXT in "${REQUIRED_EXTENSIONS[@]}"; do
        if ! php -m | grep -q "^${EXT}$"; then
            sudo apt-get install -y "php-${EXT}" > /dev/null 2>&1 || {
                echo -e "${RED}Failed to install php-${EXT}${RESET}" >&2
                exit 1
            }
        fi
    done

    STATUS='Finished'
    echo -ne "\033[1A\r${GREEN}${CHECK} ${WHITE}Installing missing php extensions \t\t ${GREEN}${STATUS} ${RESET}"
}

setup_composer() {
    STATUS='Starting'
    echo -e "\n${GREEN}${LOADING} ${WHITE}Installing php dependencies \t\t\t ${GREEN}${STATUS} ${RESET}"
    composer install -q > /dev/null 2>&1
    STATUS='Finished'
    echo -ne "\033[1A\r${GREEN}${CHECK} ${WHITE}Installing php dependencies \t\t\t ${GREEN}${STATUS} ${RESET}"

    # php -m | grep -q dom && php -m | grep -q gd && php -m | grep -q imagick && php -m | grep -q fileinfo && php -m | grep -q openssl && echo "All extensions enabled" || echo "Missing PHP extensions: ext-dom, gd, imagick, fileinfo, openssl" >&2
    # echo " DONE"
}

setup_node() {
    STATUS='Starting'
    echo -e "\n${GREEN}${LOADING} ${WHITE}Installing node dependencies \t\t\t ${GREEN}${STATUS} ${RESET}"
    npm install --silent --production -y > /dev/null
    STATUS='Finished'
    echo -ne "\033[1A\r${GREEN}${CHECK} ${WHITE}Installing node dependencies \t\t\t ${GREEN}${STATUS} ${RESET}\n"
}

if [ $# -gt 0 ]; then
    if [ "$1" == "init" ]; then
        setup_environment || exit 1
        setup_composer || exit 1
        setup_node || exit 1
    fi
fi