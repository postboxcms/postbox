    "@mui/x-data-grid": "^5.2.1",
    "@reduxjs/toolkit": "^1.9.5",
    "@tinymce/tinymce-react": "^6.2.1",
    "babel-plugin-macros": "^3.1.0",
    "core-js": "^3.21.1",
    "dotenv": "^16.0.0",
    "express": "^5.1.0",
    "history": "^4.10.0",
    "moment": "^2.29.4",
    "ora": "^9.4.0",
    "react-dropzone": "^14.2.10",
    "react-moment": "^1.1.2",
