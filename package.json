{
  "private": true,
  "scripts": {
    "dev": "npm run development",
    "development": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "prod": "npm run production",
    "prod:server": "cross-env HOST=server mix --production",
    "production": "mix --production",
    "build:client": "vite build --outDir public/build --ssrManifest",
    "build:server": "vite build --ssr resources/js/framework/website/server.js --outDir public/build/server",
    "build": "npm run build:client && npm run build:server",
    "build:prod": "cross-env NODE_ENV=production npm run prod && npm run build",
    "build:ps": "cross-env NODE_ENV=production HOST=server mix --production && vite build --ssr resources/js/framework/website/server.js --outDir public/build/server && vite build --outDir public/build --ssrManifest",
    "watch:server": "vite build --ssr resources/js/framework/website/server.js --outDir public/build/server --watch",
    "watch:client": "vite build --outDir public/build --ssrManifest --watch",
    "watch:all": "npm run watch:client && npm run watch:server && npm run watch && npm start",
    "test": "jest",
    "start": "npm run build && node server",
    "setup:cms": "node scripts/setup-postbox.mjs"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.0.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@popperjs/core": "^2.11.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.0",
    "axios": "^0.21.4",
    "babel-jest": "^30.1.2",
    "bootstrap": "^5.2.3",
    "cross-env": "^7.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jquery": "^3.2",
    "laravel-mix": "^6.0.49",
    "laravel-vite-plugin": "^2.0.1",
    "lodash": "^4.17.21",
    "popper.js": "^1.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resolve-url-loader": "^3.1.0",
    "sass": "1.70.0",
    "sass-ffi": "^0.0.2",
    "sass-loader": "^8.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
