{
  "private": true,
  "scripts": {
    "dev": "vite",
    "development": "vite",
    "watch": "vite build --watch",
    "watch-poll": "cross-env VITE_WATCH_USE_POLLING=true vite --host 0.0.0.0",
    "hot": "vite --host 0.0.0.0",
    "prod": "npm run build",
    "prod:server": "npm run build:server",
    "production": "vite build --outDir public/build --ssrManifest",
    "build:client": "vite build --outDir public/build --ssrManifest",
    "build:server": "vite build --ssr resources/js/framework/website/server.js --outDir public/build/server",
    "build": "npm run build:client && npm run build:server",
    "build:prod": "cross-env NODE_ENV=production npm run build",
    "build:ps": "cross-env NODE_ENV=production npm run build",
    "watch:server": "vite build --ssr resources/js/framework/website/server.js --outDir public/build/server --watch",
    "watch:client": "vite build --outDir public/build --ssrManifest --watch",
    "watch:all": "npm run watch:client && npm run watch:server && npm run watch && npm start",
    "test": "jest",
    "start": "npm run build && node server",
    "setup:cms": "node scripts/setup.mjs"
  },
